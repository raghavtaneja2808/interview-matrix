# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────
# MongoDB Atlas
# Create a free cluster at https://cloud.mongodb.com
# ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/interview-matrix?retryWrites=true&w=majority

# ─────────────────────────────────────────────
# JWT
# Generate a strong random string (e.g. `openssl rand -hex 64`)
# ─────────────────────────────────────────────
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# Google OAuth — https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (type: Web application)
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─────────────────────────────────────────────
# Groq AI  — https://console.groq.com/keys
# ─────────────────────────────────────────────
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=llama-3.3-70b-versatile

# ─────────────────────────────────────────────
# ElevenLabs  — https://elevenlabs.io/app/settings/api-keys
# ─────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_xxx
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
